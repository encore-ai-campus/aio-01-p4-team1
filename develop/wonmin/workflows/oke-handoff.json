        1440,
        300
      ],
      "parameters": {
        "jsCode": "const input = $('H03 Select Store').first().json;\nconst reply = $input.first().json;\nconst b = reply.body;\nconst confirmed = b && typeof b.ticket_id === 'string' && /^T-\\d+$/.test(b.ticket_id)\n  && ((reply.statusCode === 201 && b.duplicate === false) || (reply.statusCode === 200 && b.duplicate === true));\nconst ticket = confirmed ? { ticket_id: b.ticket_id, priority: input.priority, duplicate: b.duplicate } : null;\nconst alert_payload = confirmed ? { workflow: 'oke-handoff', node: 'H06 Keep Ticket',\n  message: '담당자 이관 티켓이 접수되었습니다.', severity: input.priority === 'high' ? 'high' : 'normal',\n  ticket_id: b.ticket_id } : null;\nif (alert_payload && input.mode === 'app') alert_payload.event_key = input.request_id + ':ticket-created';\nreturn [{ json: { mode: input.mode, base_url: input.base_url, ticket, alert_payload } }];"
      }
