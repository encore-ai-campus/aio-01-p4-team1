      "parameters": {
        "jsCode": "const input = $('H03 Select Store').first().json;\nconst reply = $input.first().json;\nconst b = reply.body;\nconst confirmed = b && typeof b.ticket_id === 'string' && /^T-\\d+$/.test(b.ticket_id)\n  && ((reply.statusCode === 201 && b.duplicate === false) || (reply.statusCode === 200 && b.duplicate === true));\nconst ticket = confirmed ? { ticket_id: b.ticket_id, priority: input.priority, duplicate: b.duplicate } : null;\nconst attempts = $('H05 Recheck Budget').first().json.will_retry ? 2 : 1;\nreturn [{ json: { request_id: input.request_id, priority: input.priority, mode: input.mode,\n  base_url: input.base_url, ticket, attempts,\n  last_status: Number.isInteger(reply.statusCode) ? reply.statusCode : null } }];"
