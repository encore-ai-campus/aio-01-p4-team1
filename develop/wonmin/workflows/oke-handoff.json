      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst employees = ['이준호', '박서연', '최유진', '한지훈', '김민지', '정우성'];\nconst text = v => typeof v === 'string' && v.trim().length > 0;\nconst valid = body && typeof body === 'object' && !Array.isArray(body)\n  && ['request_id', 'requester', 'title', 'category', 'priority', 'reason'].every(k => text(body[k]))\n  && [...body.request_id].length <= 64 && employees.includes(body.requester)\n  && ['normal', 'high'].includes(body.priority)\n  && (body.evidence_summary === undefined || typeof body.evidence_summary === 'string');\nif (!valid) return [{ json: { valid: false, http_status: 400,\n  response: { error: { message: '이관 입력을 확인해 주세요.' } } } }];\nconst mask = value => value\n  .replace(/\\bBearer\\s+[^\\s,;]+/gi, 'Bearer [REDACTED]')\n  .replace(/((?:password|passwd|token|api[_-]?key|비밀번호|암호)\\s*[:=]\\s*)[^\\s,;]+/gi, '$1[REDACTED]')\n  .replace(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/gi, '[EMAIL]')\n  .replace(/(?:\\+82[\\s.-]?)?0?1[016789][\\s.-]?\\d{3,4}[\\s.-]?\\d{4}/g, '[PHONE]');\n// evidence_summary is not part of C05 and is intentionally discarded, as are headers and extra fields.\nreturn [{ json: { valid: true, request_id: body.request_id, priority: body.priority,\n  ticket_payload: { key: body.request_id, title: mask(body.title.trim()), requester: body.requester,\n    category: body.category.trim(), priority: body.priority } } }];"
      }
