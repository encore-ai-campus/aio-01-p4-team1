        "jsCode": "const state = $('H07 Failure Context').first().json;\nconst reply = $input.first().json;\nconst b = reply.body;\nconst countValid = b && Number.isSafeInteger(b.count) && b.count >= 1;\nconst ack = countValid && ((b.stored === 1 && b.duplicate !== true)\n  || (state.mode === 'app' && b.stored === 0 && b.duplicate === true));\nconst alerted = Boolean(reply.statusCode === 200 && ack);\nconst need_dlq = !state.ticket || !alerted;\nconst safe_payload = { stage: state.ticket ? 'alert' : 'ticket', priority: state.priority, attempts: state.attempts };\nif (Number.isInteger(state.last_status)) safe_payload.last_status = state.last_status;\nif (state.ticket) safe_payload.ticket_id = state.ticket.ticket_id;\nconst dlq_payload = { request_id: state.request_id, workflow: 'oke-handoff',\n  node: state.ticket ? 'H08 Store Alert' : 'H04 Create Ticket',\n  reason: state.ticket ? 'alerts_down' : 'tickets_down', safe_payload };\n// Safe operational summary only. Recovery uses backend inquiry/ticket linkage; no automatic replay.\nreturn [{ json: { request_id: state.request_id, mode: state.mode, base_url: state.base_url,\n  ticket: state.ticket, alerted, dlq: false, need_dlq, dlq_payload } }];"
