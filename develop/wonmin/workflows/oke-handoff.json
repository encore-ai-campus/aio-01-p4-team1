      "parameters": {
        "jsCode": "const state = $('H06 Keep Ticket').first().json;\nconst reply = $input.first().json;\nconst b = reply.body;\nconst stored = b && Number.isSafeInteger(b.count) && b.count >= 1\n  && (b.stored === 1 || (state.mode === 'app' && b.stored === 0 && b.duplicate === true));\nconst alerted = Boolean(state.ticket && reply.statusCode === 200 && stored);\n// P1-1 only: no retry or DLQ yet. Partial-failure ok is conservatively false pending WM-04.\nreturn [{ json: { http_status: 200, response: { ok: Boolean(state.ticket && alerted), ticket: state.ticket,\n  reason: !state.ticket ? 'tickets_down' : alerted ? null : 'alerts_down', alerted, dlq: false } } }];"
