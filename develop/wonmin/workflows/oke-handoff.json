      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst unavailable = () => [{ json: { ready: false, http_status: 503, response:\n  { ok: false, ticket: null, reason: 'tickets_down', alerted: false, dlq: false } } }];\ntry {\n  const mode = $env.SERVICE_MODE;\n  if (!['practice', 'app'].includes(mode)) return unavailable();\n  const value = mode === 'app' ? ($env.WONMIN_APP_STORE_URL || 'http://backend:8000')\n    : ($env.WONMIN_PRACTICE_STORE_URL || 'http://data-api:8800');\n  // Origin-only deployment setting, parsed without external modules or sandbox URL globals.\n  const match = typeof value === 'string' && /^(https?:\\/\\/[a-zA-Z0-9.-]+)(?::([0-9]{1,5}))?\\/?$/.exec(value);\n  if (!match || (match[2] && (Number(match[2]) < 1 || Number(match[2]) > 65535))) return unavailable();\n  const base_url = match[1] + (match[2] ? ':' + match[2] : '');\n  return [{ json: { ...input, ready: true, mode, base_url } }];\n} catch { return unavailable(); }"
      }
