        1280,
        300
      ],
      "parameters": {
        "jsCode": "const state = $('H03 Select Store').first().json;\nconst raw = $input.first().json;\nconst status = Number.isInteger(raw.statusCode) ? raw.statusCode : null;\nconst b = raw.body;\nconst ticketBody = b && typeof b.ticket_id === 'string' && /^T-\\d+$/.test(b.ticket_id)\n  && typeof b.duplicate === 'boolean' ? { ticket_id: b.ticket_id, duplicate: b.duplicate } : null;\nconst confirmed = ticketBody && ((status === 201 && !ticketBody.duplicate) || (status === 200 && ticketBody.duplicate));\nlet wait_ms = state.retry_wait_ms;\nlet retryable = !confirmed && (Boolean(raw.error) || (status >= 500 && status <= 599) || status === 429);\nif (status === 429) {\n  const header = raw.headers?.['retry-after'] ?? raw.headers?.['Retry-After'];\n  if (header !== undefined) {\n    if (typeof header !== 'string' || !header.trim()) retryable = false;\n    else {\n      const value = header.trim();\n      const dateFormat = /^[A-Za-z]{3}, \\d{2} [A-Za-z]{3} \\d{4} \\d{2}:\\d{2}:\\d{2} GMT$/.test(value);\n      const parsed = /^\\d+$/.test(value) ? Number(value) * 1000 : dateFormat ? Date.parse(value) - Date.now() : NaN;\n      if (!Number.isFinite(parsed) || parsed > 200) retryable = false;\n      else wait_ms = Math.max(0, parsed);\n    }\n  }\n}\nconst will_retry = Boolean(retryable && Date.now() + wait_ms + 1000 + 1200 <= state.deadline_at);\n// Retain only a validated response projection. Never retain error bodies, headers or stack.\nreturn [{ json: { ...state, will_retry, wait_ms, first_reply: { statusCode: status, body: ticketBody } } }];"
