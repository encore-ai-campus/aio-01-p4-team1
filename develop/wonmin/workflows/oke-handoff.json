        "jsCode": "const state = $input.first().json;\nconst alert_payload = { workflow: 'oke-handoff', node: state.ticket ? 'H06 Keep Ticket' : 'H04 Create Ticket',\n  message: state.ticket ? '담당자 이관 티켓이 접수되었습니다.' : '티켓 저장 결과를 확인하지 못했습니다.',\n  severity: !state.ticket || state.priority === 'high' ? 'high' : 'normal' };\nif (state.ticket) alert_payload.ticket_id = state.ticket.ticket_id;\nif (state.mode === 'app') alert_payload.event_key = state.request_id + (state.ticket ? ':ticket-created' : ':tickets-down');\nreturn [{ json: { ...state, alert_payload, alerted: false, dlq: false } }];"
