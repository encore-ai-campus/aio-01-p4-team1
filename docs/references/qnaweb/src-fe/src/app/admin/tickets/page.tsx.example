"use client";

import React, { useCallback, useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import { apiFetch, getStoredAuth, IntegrationItem, QnaItem } from "@/lib/api";

export default function AdminTicketsPage() {
  const router = useRouter();
  const [tickets, setTickets] = useState<QnaItem[]>([]);
  const [integrations, setIntegrations] = useState<IntegrationItem[]>([]);
  const [statusFilter, setStatusFilter] = useState("ALL");
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [answerDrafts, setAnswerDrafts] = useState<Record<number, string>>({});
  const [statusDrafts, setStatusDrafts] = useState<Record<number, string>>({});
  const [savingId, setSavingId] = useState<number | null>(null);

  const loadTickets = useCallback(async (filterVal: string) => {
    setLoading(true);
    setError(null);
    try {
      const qs =
        filterVal && filterVal !== "ALL" ? `?ticket_status=${filterVal}` : "";
      const [ticketList, integrationList] = await Promise.all([
        apiFetch<QnaItem[]>(`/api/admin/tickets${qs}`),
        apiFetch<IntegrationItem[]>("/api/admin/integrations"),
      ]);
      setTickets(ticketList);
      setIntegrations(integrationList);

      const nextAnswers: Record<number, string> = {};
      const nextStatuses: Record<number, string> = {};
      ticketList.forEach((t) => {
        nextAnswers[t.id] = t.admin_answer || "";
        nextStatuses[t.id] = t.ticket_status || "OPEN";
      });
      setAnswerDrafts(nextAnswers);
      setStatusDrafts(nextStatuses);
    } catch (err: unknown) {
      setError(
        err instanceof Error
          ? err.message
          : "담당자 티켓 목록을 불러오지 못했습니다."
      );
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    const { token, user } = getStoredAuth();
    if (!token || !user) {
      router.replace("/login");
      return;
    }
    if (user.role !== "ADMIN") {
      router.replace("/qna/new");
      return;
    }
    loadTickets("ALL");
  }, [router, loadTickets]);

  const handleSaveTicket = async (qnaId: number) => {
    setSavingId(qnaId);
    setError(null);
    try {
      const updated = await apiFetch<QnaItem>(`/api/admin/tickets/${qnaId}`, {
        method: "PATCH",
        body: JSON.stringify({
          ticket_status: statusDrafts[qnaId] || "OPEN",
          admin_answer: answerDrafts[qnaId] ?? "",
        }),
      });
      setTickets((prev) => prev.map((t) => (t.id === qnaId ? updated : t)));
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : "티켓 저장 실패");
    } finally {
      setSavingId(null);
    }
  };

  return (
    <div className="space-y-8">
      <div className="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 className="text-2xl font-bold text-slate-900">담당자 티켓 관리</h1>
          <p className="text-sm text-slate-500 mt-1">
            담당자에게 이관된 문의 티켓의 처리 상태와 최종 조치 답변, 외부 시스템 연동 내역을 관리합니다.
          </p>
        </div>

        <div className="flex items-center gap-2">
          {["ALL", "OPEN", "IN_PROGRESS", "RESOLVED", "CLOSED"].map((st) => (
            <button
              key={st}
              onClick={() => {
                setStatusFilter(st);
                loadTickets(st);
              }}
              className={`px-3 py-1.5 rounded-lg text-xs font-semibold border transition ${
                statusFilter === st
                  ? "bg-slate-900 text-white border-slate-900"
                  : "bg-white text-slate-700 border-slate-300 hover:bg-slate-100"
              }`}
            >
              {st}
            </button>
          ))}
        </div>
      </div>

      {error && (
        <div className="p-4 rounded-xl bg-red-50 border border-red-200 text-sm text-red-700">
          {error}
        </div>
      )}

      {loading ? (
        <div className="bg-white rounded-xl border border-slate-200 p-12 text-center text-sm text-slate-500">
          담당자 티켓 내역을 불러오는 중입니다...
        </div>
      ) : tickets.length === 0 ? (
        <div className="bg-white rounded-xl border border-slate-200 p-12 text-center text-sm text-slate-500">
          이관된 담당자 티켓이 없습니다.
        </div>
      ) : (
        <div className="space-y-6">
          {tickets.map((t) => (
            <div
              key={t.id}
              className="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden"
            >
              <div className="px-6 py-4 bg-amber-50/60 border-b border-amber-200 flex flex-wrap items-center justify-between gap-3">
                <div className="flex items-center gap-3">
                  <span className="text-xs font-mono font-bold bg-amber-500 text-white px-2.5 py-0.5 rounded">
                    TICKET #{t.id}
                  </span>
                  <span className="text-sm font-bold text-slate-900">
                    {t.title}
                  </span>
                  {t.external_ref_id && (
                    <span className="text-xs font-mono bg-white border border-amber-300 text-amber-900 px-2 py-0.5 rounded">
                      외부연동: {t.external_ref_id} ({t.external_sync_status})
                    </span>
                  )}
                </div>
                <div className="text-xs text-slate-500">
                  요청자: <strong>{t.user_name}</strong> ({t.department}) · 이관일시:{" "}
                  {t.escalated_at
                    ? new Date(t.escalated_at).toLocaleString("ko-KR")
                    : "-"}
                </div>
              </div>

              <div className="p-6 space-y-4">
                <div className="text-sm text-slate-700 bg-slate-50 rounded-lg p-4 border border-slate-100 whitespace-pre-wrap">
                  {t.content}
                </div>

                {/* 티켓 상태 변경 및 담당자 답변 폼 */}
                <div className="grid grid-cols-1 md:grid-cols-12 gap-4 items-start pt-2">
                  <div className="md:col-span-3">
                    <label className="block text-xs font-semibold text-slate-700 mb-1">
                      티켓 처리 상태
                    </label>
                    <select
                      value={statusDrafts[t.id] || "OPEN"}
                      onChange={(e) =>
                        setStatusDrafts((prev) => ({
                          ...prev,
                          [t.id]: e.target.value,
                        }))
                      }
                      className="w-full rounded-lg border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500"
                    >
                      <option value="OPEN">OPEN (이관 접수)</option>
                      <option value="IN_PROGRESS">IN_PROGRESS (처리중)</option>
                      <option value="RESOLVED">RESOLVED (해결 완료)</option>
                      <option value="CLOSED">CLOSED (종료)</option>
                    </select>
                  </div>

                  <div className="md:col-span-7">
                    <label className="block text-xs font-semibold text-slate-700 mb-1">
                      담당자 조치 및 최종 답변
                    </label>
                    <textarea
                      rows={2}
                      value={answerDrafts[t.id] ?? ""}
                      onChange={(e) =>
                        setAnswerDrafts((prev) => ({
                          ...prev,
                          [t.id]: e.target.value,
                        }))
                      }
                      placeholder="담당자 조치 결과 또는 사용자에게 전달할 최종 답변을 입력하세요..."
                      className="w-full rounded-lg border border-slate-300 px-3 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-amber-500"
                    />
                  </div>

                  <div className="md:col-span-2 flex md:justify-end pt-5">
                    <button
                      type="button"
                      onClick={() => handleSaveTicket(t.id)}
                      disabled={savingId === t.id}
                      className="w-full bg-amber-600 hover:bg-amber-500 disabled:opacity-50 text-white text-xs font-semibold px-4 py-2.5 rounded-lg shadow-sm transition"
                    >
                      {savingId === t.id ? "저장 중..." : "티켓 업데이트"}
                    </button>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}

      {/* 외부 시스템 연동 테이블 내역 */}
      <div className="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div className="px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
          <h2 className="text-sm font-bold text-slate-900">
            외부 시스템 연동 테이블 이력 (external_integrations)
          </h2>
          <span className="text-xs text-slate-500">
            총 {integrations.length}건
          </span>
        </div>
        <div className="overflow-x-auto">
          <table className="w-full text-left border-collapse text-xs">
            <thead>
              <tr className="border-b border-slate-200 text-slate-500 bg-slate-50/50">
                <th className="py-2.5 px-4">ID</th>
                <th className="py-2.5 px-4">QNA ID</th>
                <th className="py-2.5 px-4">외부 시스템</th>
                <th className="py-2.5 px-4">외부 참조 ID</th>
                <th className="py-2.5 px-4">연동 유형</th>
                <th className="py-2.5 px-4">상태</th>
                <th className="py-2.5 px-4">연동 시각</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-200">
              {integrations.map((ext) => (
                <tr key={ext.id} className="hover:bg-slate-50">
                  <td className="py-2.5 px-4 font-mono">#{ext.id}</td>
                  <td className="py-2.5 px-4 font-mono">
                    {ext.qna_id ? `#${ext.qna_id}` : "-"}
                  </td>
                  <td className="py-2.5 px-4 font-semibold text-slate-800">
                    {ext.system_name}
                  </td>
                  <td className="py-2.5 px-4 font-mono text-blue-600">
                    {ext.external_ref_id || "-"}
                  </td>
                  <td className="py-2.5 px-4">{ext.sync_type}</td>
                  <td className="py-2.5 px-4">
                    <span className="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-100 text-emerald-800">
                      {ext.sync_status}
                    </span>
                  </td>
                  <td className="py-2.5 px-4 text-slate-500">
                    {ext.synced_at
                      ? new Date(ext.synced_at).toLocaleString("ko-KR")
                      : "-"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}
