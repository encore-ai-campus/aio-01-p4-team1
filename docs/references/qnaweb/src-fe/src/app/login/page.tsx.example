"use client";

import React, { useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import { apiFetch, setStoredAuth, User } from "@/lib/api";

interface LoginResponse {
  access_token: string;
  token_type: string;
  user: User;
}

export default function LoginPage() {
  const router = useRouter();
  const [username, setUsername] = useState("user01");
  const [password, setPassword] = useState("REPLACE_LOCAL_SECRET");
  const [sampleUsers, setSampleUsers] = useState<User[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    apiFetch<User[]>("/api/users/sample")
      .then((data) => setSampleUsers(data))
      .catch(() => {});
  }, []);

  const performLogin = async (targetUsername: string, targetPassword: string) => {
    setLoading(true);
    setError(null);
    try {
      const res = await apiFetch<LoginResponse>("/api/auth/login", {
        method: "POST",
        body: JSON.stringify({
          username: targetUsername,
          password: targetPassword,
        }),
      });
      setStoredAuth(res.access_token, res.user);
      if (res.user.role === "ADMIN") {
        router.push("/admin/dashboard");
      } else {
        router.push("/qna/new");
      }
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : "로그인에 실패했습니다.");
    } finally {
      setLoading(false);
    }
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    await performLogin(username, password);
  };

  return (
    <div className="max-w-4xl mx-auto py-8">
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        {/* 로그인 카드 */}
        <div className="lg:col-span-5 bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8">
          <div className="mb-6">
            <span className="inline-block bg-blue-600 text-white text-xs font-extrabold px-2.5 py-1 rounded-md mb-2">
              INTERNAL Q&A
            </span>
            <h1 className="text-2xl font-bold text-slate-900">사내 Q&A 로그인</h1>
            <p className="text-xs text-slate-500 mt-1">
              사내 계정으로 로그인하여 질문하기 및 문의 내역을 확인하세요.
            </p>
          </div>

          {error && (
            <div className="mb-4 p-3 rounded-lg bg-red-50 border border-red-200 text-xs text-red-700">
              {error}
            </div>
          )}

          <form onSubmit={handleSubmit} className="space-y-4">
            <div>
              <label className="block text-xs font-semibold text-slate-700 mb-1">
                사내 아이디 (사번)
              </label>
              <input
                type="text"
                value={username}
                onChange={(e) => setUsername(e.target.value)}
                required
                className="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                placeholder="예: user01 또는 admin01"
              />
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-700 mb-1">
                비밀번호
              </label>
              <input
                type="password"
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                required
                className="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
              <p className="text-[11px] text-slate-400 mt-1">
                샘플 계정 초기 비밀번호: <code>REPLACE_LOCAL_SECRET</code>
              </p>
            </div>

            <button
              type="submit"
              disabled={loading}
              className="w-full bg-blue-600 hover:bg-blue-500 disabled:opacity-50 text-white font-semibold py-2.5 rounded-lg text-sm shadow-sm transition"
            >
              {loading ? "로그인 중..." : "로그인"}
            </button>
          </form>
        </div>

        {/* 10명 샘플 사용자(관리자 1명 + 일반사용자 9명) 선택 패널 */}
        <div className="lg:col-span-7 bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8">
          <div className="flex items-center justify-between mb-4">
            <div>
              <h2 className="text-base font-bold text-slate-900">
                사내 샘플 사용자 (총 10명: 관리자 1명 / 일반사용자 9명)
              </h2>
              <p className="text-xs text-slate-500 mt-0.5">
                계정을 클릭하면 해당 사용자로 즉시 로그인하거나 아이디가 자동 입력됩니다.
              </p>
            </div>
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            {sampleUsers.map((u) => {
              const isAdmin = u.role === "ADMIN";
              return (
                <div
                  key={u.id}
                  onClick={() => {
                    setUsername(u.username);
                    setPassword("REPLACE_LOCAL_SECRET");
                    performLogin(u.username, "REPLACE_LOCAL_SECRET");
                  }}
                  className={`cursor-pointer rounded-xl border p-3 transition flex items-center justify-between ${
                    isAdmin
                      ? "bg-amber-50/70 border-amber-300 hover:bg-amber-100/70"
                      : "bg-slate-50 border-slate-200 hover:bg-blue-50 hover:border-blue-300"
                  }`}
                >
                  <div>
                    <div className="flex items-center gap-2">
                      <span className="text-sm font-bold text-slate-900">
                        {u.name}
                      </span>
                      <span
                        className={`text-[10px] font-bold px-2 py-0.5 rounded-full ${
                          isAdmin
                            ? "bg-amber-500 text-slate-950"
                            : "bg-slate-200 text-slate-700"
                        }`}
                      >
                        {isAdmin ? "관리자 (ADMIN)" : "일반사용자"}
                      </span>
                    </div>
                    <div className="text-xs text-slate-500 mt-0.5">
                      {u.department} · <code className="font-mono">{u.username}</code>
                    </div>
                  </div>
                  <span className="text-xs font-semibold text-blue-600">
                    선택 →
                  </span>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  );
}
