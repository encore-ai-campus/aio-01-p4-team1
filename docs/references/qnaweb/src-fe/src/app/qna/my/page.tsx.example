"use client";

import React, { useCallback, useEffect, useState } from "react";
import Link from "next/link";
import { useRouter } from "next/navigation";
import { apiFetch, getStoredAuth, QnaItem } from "@/lib/api";
import QnaDetailCard from "@/components/QnaDetailCard";

export default function QnaMyPage() {
  const router = useRouter();
  const [items, setItems] = useState<QnaItem[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const loadMyQuestions = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const data = await apiFetch<QnaItem[]>("/api/qna/my");
      setItems(data);
    } catch (err: unknown) {
      setError(
        err instanceof Error ? err.message : "내 문의 목록을 불러오지 못했습니다."
      );
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    const { token } = getStoredAuth();
    if (!token) {
      router.replace("/login");
      return;
    }
    loadMyQuestions();
  }, [router, loadMyQuestions]);

  const handleUpdated = (updated: QnaItem) => {
    setItems((prev) => prev.map((q) => (q.id === updated.id ? updated : q)));
  };

  return (
    <div className="space-y-6">
      <div className="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 className="text-2xl font-bold text-slate-900">내 문의 확인</h1>
          <p className="text-sm text-slate-500 mt-1">
            등록한 질문의 자동답변(비워둠), 담당자 이관 상태 및 보완 질문을 확인하고 관리합니다.
          </p>
        </div>
        <Link
          href="/qna/new"
          className="bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold px-4 py-2.5 rounded-xl shadow-sm transition"
        >
          + 새 질문하기
        </Link>
      </div>

      {error && (
        <div className="p-4 rounded-xl bg-red-50 border border-red-200 text-sm text-red-700">
          {error}
        </div>
      )}

      {loading ? (
        <div className="bg-white rounded-xl border border-slate-200 p-12 text-center text-sm text-slate-500">
          내 문의 내역을 불러오는 중입니다...
        </div>
      ) : items.length === 0 ? (
        <div className="bg-white rounded-xl border border-slate-200 p-12 text-center space-y-3">
          <p className="text-sm text-slate-500">등록된 내 문의 내역이 없습니다.</p>
          <Link
            href="/qna/new"
            className="inline-block bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold px-4 py-2 rounded-lg"
          >
            첫 질문 등록하기
          </Link>
        </div>
      ) : (
        <div className="space-y-6">
          {items.map((item) => (
            <QnaDetailCard
              key={item.id}
              item={item}
              onUpdated={handleUpdated}
              isAdminView={false}
            />
          ))}
        </div>
      )}
    </div>
  );
}
