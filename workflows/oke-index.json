{
  "name": "oke-index",
  "active": false,
  "nodes": [
    {
      "id": "index-manual",
      "name": "수동 색인 시작",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "index-http",
      "name": "실제 색인 서비스 호출",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INDEX_SERVICE_URL }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 180000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "notes": "내부 전용 HTTP. X-Team-Key Header Auth Credential은 n8n UI에 연결한다. URL과 키를 워크플로우에 저장하지 않는다.",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_LOCAL_HEADER_AUTH_CREDENTIAL_ID",
          "name": "Header Auth account"
        }
      }
    },
    {
      "id": "index-result",
      "name": "색인 결과 검증",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const x=$input.first().json;\nif (x.error || !x.body || typeof x.body!=='object') return [{json:{ok:false,reason:'index_unavailable'}}];\nconst b=x.body;\nif (x.statusCode!==200 || b.ok!==true || !b.counts || !Array.isArray(b.documents) || b.documents.length!==8 || b.counts.failed!==0 || b.counts.rejected!==0) return [{json:{ok:false,reason:'index_unavailable'}}];\nreturn [{json:{ok:true,mode:b.mode,counts:b.counts,documents:b.documents.map(d=>({doc_key:d.doc_key,status:d.status,chunk_count:d.chunk_count,reason:d.reason}))}}];"
      },
      "notes": "성공 건수와 문서별 상태만 반환한다. 비밀값·원문·벡터는 반환하지 않는다."
    }
  ],
  "connections": {
    "수동 색인 시작": {
      "main": [
        [
          {
            "node": "실제 색인 서비스 호출",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "실제 색인 서비스 호출": {
      "main": [
        [
          {
            "node": "색인 결과 검증",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": true
  },
  "pinData": {},
  "meta": {
    "phase": "P1-1 real index HTTP trigger prepared, inactive",
    "realIndexingVerified": false
  },
  "id": "okeIndexFlow01"
}
